    "status": 200,
    "body": {
      "name": "Product",
      "fields": [
        {
          "path": "sku",
          "type": "TEXT",
          "required": true,
          "description": "Stock keeping unit: unique identifier of the sellable item or variant. Text, leading zeros are significant."
        },
        {
          "path": "name",
          "type": "TEXT",
          "required": true,
          "description": "Customer-facing product name, English preferred."
        },
        {
          "path": "brand",
          "type": "TEXT",
          "required": true,
          "description": "Brand or maison the product is sold under."
        },
        {
          "path": "category",
          "type": "TEXT",
          "required": true,
          "description": "Merchandise category, e.g. Bags, Shoes, Ready-to-wear."
        },
        {
          "path": "price.amount",
          "type": "DECIMAL",
          "required": true,
          "description": "Current selling price, tax included. Not a compare-at or original price."
        },
        {
          "path": "price.currency",
          "type": "TEXT",
          "required": true,
          "description": "ISO 4217 currency code, e.g. EUR."
        },
        {
          "path": "material",
          "type": "TEXT",
          "required": false,
          "description": "Main material or composition."
        },
        {
          "path": "color",
          "type": "TEXT",
          "required": false,
          "description": "Colour name, e.g. Black."
        },
        {
          "path": "size",
          "type": "TEXT",
          "required": false,
          "description": "Size label, e.g. M, 38, One size."
        },
        {
          "path": "stock_quantity",
          "type": "INTEGER",
          "required": false,
          "description": "Units available to sell."
        },
        {
          "path": "created_at",
          "type": "TIMESTAMP",
          "required": false,
          "description": "When the product record was created."
        }
      ]
    }
  },
