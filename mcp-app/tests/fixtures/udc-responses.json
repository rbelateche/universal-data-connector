  "export-erp-dbt": {
    "method": "GET",
    "path": "/sources/erp/mapping/export?format=dbt_sql",
    "request": null,
    "status": 200,
    "body": {
      "source_id": "erp",
      "mapping_id": 1,
      "format": "dbt_sql",
      "filename": "stg_erp__product.sql",
      "content": "-- Generated by Universal Data Connector from mapping #1\n-- Source: erp (SAP ERP material export) → Product\n-- Dialect: DuckDB (dbt-duckdb). Only reviewed or high-confidence mappings are applied.\n-- Warnings:\n--   - MTART → material is pending review (42%) and was left out.\n--   - MATKL → category is pending review (58%) and was left out.\n--   - Required field brand has no source field; it is exported as NULL.\n--   - Required field category is exported as NULL until MATKL → category is reviewed.\n\nwith source as (\n    select * from {{ source('udc', 'erp') }}\n),\n\nprepared as (\n    select * from source\n)\n\nselect\n    cast(\"MATNR\" as bigint) as sku,  -- MATNR, cast_int\n    cast(\"MAKTX\" as varchar) as name,  -- MAKTX, rename\n    cast(null as varchar) as brand,  -- TODO: no source field (required)\n    cast(null as varchar) as category,  -- TODO: MATKL is pending review (required)\n    cast(cast(\"NETPR\" as double) as decimal(18, 2)) as price_amount,  -- NETPR, cast_float\n    cast(\"WAERS\" as varchar) as price_currency,  -- WAERS, rename\n    cast(null as varchar) as material,  -- TODO: MTART is pending review\n    cast(null as varchar) as color,  -- TODO: no source field\n    cast(null as varchar) as size,  -- TODO: no source field\n    cast(\"LABST\" as bigint) as stock_quantity,  -- LABST, cast_int\n    strptime(trim(\"ERSDA\"), '%Y%m%d') as created_at  -- ERSDA, parse_date\nfrom prepared\n",
      "warnings": [
        "MTART → material is pending review (42%) and was left out.",
        "MATKL → category is pending review (58%) and was left out.",
        "Required field brand has no source field; it is exported as NULL.",
        "Required field category is exported as NULL until MATKL → category is reviewed."
      ]
    }
  },
