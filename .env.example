# ─── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://udc:udc_secret@localhost:5432/udc_demo

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional (defaults shown) ────────────────────────────────────────────────
# Claude model used for schema mapping inference. The mapper forces its
# submit_mapping tool call (tool_choice "any"): Haiku 5.5 accepts that,
# Sonnet 5.5 and Opus 5.5 reject it with a 400.
ANTHROPIC_MODEL=claude-haiku-5-5

# Path to the DuckDB file for local storage
DUCKDB_PATH=./data/udc.duckdb

# Static API key protecting the FastAPI backend
API_KEY=change-me-in-production

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Application environment: development | production
APP_ENV=development
